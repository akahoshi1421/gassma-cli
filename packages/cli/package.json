{
  "name": "gassma",
  "version": "2.0.0",
  "description": "GASsma is Google Apps Script(GAS) of SpreadSheet library that can be used like prisma.",
  "types": "index.d.ts",
  "bin": {
    "gassma": "bin/index.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "index.d.ts",
    "docs/README.ja.md"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./config": {
      "types": "./dist/config/defineConfig.d.ts",
      "require": "./dist/config/defineConfig.js",
      "import": "./dist/config/defineConfig.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:types": "tsx scripts/genFixtureTypes.ts",
    "test:types": "vitest --typecheck --run",
    "pretest:types:all": "tsx scripts/genFixtureTypes.ts",
    "test:types:all": "tsx scripts/checkTypeMatrix.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src"
  },
  "author": "akahoshi1421",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/akahoshi1421/gassma-cli.git"
  },
  "homepage": "https://gassma.io/",
  "bugs": {
    "url": "https://github.com/akahoshi1421/gassma-cli/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "typescript": ">=5.2"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@loancrate/prisma-schema-parser": "^3.0.0",
    "@prisma/internals": "^7.5.0",
    "commander": "^12.1.0",
    "jiti": "^2.6.1",
    "open": "^11.0.0",
    "pluralize": "^8.0.0"
  },
  "keywords": [
    "Google Apps Script",
    "google-apps-script",
    "GAS",
    "GASsma",
    "spreadsheet",
    "prisma",
    "ORM",
    "TypeScript",
    "JavaScript",
    "CLI"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@types/node": "^22.10.2",
    "@types/pluralize": "^0.0.33",
    "ci-info": "^4.4.0",
    "globals": "^15.13.0",
    "package-manager-detector": "^1.8.0",
    "tsdown": "^0.22.12",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
